{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yeptennis-updated",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "TENNIS_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "0 */4 * * *"
    ]
  }
}
